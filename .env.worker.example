# Copy to .env.worker and chmod 600. Never commit the copied file.
WEALTHFOLIO_URL=http://host.docker.internal:8088
WEALTHFOLIO_ACCOUNT_ID=
# Required when Wealthfolio authentication is enabled.
WEALTHFOLIO_AUTH_TOKEN=
TRADING212_ENVIRONMENT=live
TRADING212_API_KEY=
TRADING212_API_SECRET=
SYNC_ON_START=true
# Daily by default. Use 3600000 for hourly testing.
SYNC_INTERVAL_MS=86400000
